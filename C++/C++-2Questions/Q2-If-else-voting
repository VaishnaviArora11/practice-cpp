//                                        Question 2 : If-Else Voting System 

// Input age and print whether the person is eligible for voting or not 
// if age >= 18 then print YES
// otherwise print NO


#include <iostream>
using namespace std;

int main(){
    int a;
    cin >> a;
    if (a >= 18){
        cout << "YES";
    } else {
        cout << "NO";
    }
}